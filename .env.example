VITE_SUPABASE_ANON_KEY=your-anon-key

# URL de production
VITE_PRODUCTION_URL=https://minegrid-equipement.com

# Stripe (paiements)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Global Monitor API
VITE_MONITOR_API_URL=http://localhost:8000
VITE_MONITOR_ADMIN_TOKEN=

# n8n Webhooks (automatisations)
VITE_N8N_IMPORT_PARC_URL=
VITE_N8N_SCRAPE_PDF_URL=
VITE_N8N_ASSISTANT_URL=
VITE_N8N_AUTO_SPECS_URL=

# WhatsApp (bouton dans le widget chat) — indicatif pays + numéro, chiffres seuls, sans +
# Exemple Maroc : 212612345678
VITE_WHATSAPP_NUMBER=

# Analytics : charger le script Plausible sur index.html puis window.plausible sera utilisé par src/utils/analytics.ts
