# Supabase (obligatoire)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL de production
VITE_PRODUCTION_URL=https://minegrid-equipement.com

# Stripe (paiements)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Global Monitor API
VITE_MONITOR_API_URL=http://localhost:8000
# !!! SECURITE !!!
# VITE_MONITOR_ADMIN_TOKEN est expose dans le bundle JS (prefixe VITE_*).
# Ne JAMAIS y mettre un token de production. A termes (sprint ulterieur),
# ces endpoints /admin/* seront relayes par une edge function Supabase qui
# detient seule le vrai token cote serveur. Pour l'instant, ce token n'est
# envoye qu'aux endpoints /admin/* (jamais aux endpoints publics), et le
# backend exige AUSSI un Bearer Supabase valide (defense en profondeur).
VITE_MONITOR_ADMIN_TOKEN=

# n8n Webhooks (automatisations)
VITE_N8N_IMPORT_PARC_URL=
VITE_N8N_SCRAPE_PDF_URL=
VITE_N8N_ASSISTANT_URL=
VITE_N8N_AUTO_SPECS_URL=
